* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: #f5f6f8;
  color: #111827;
  line-height: 1.6;
}

.container {
  width: min(1100px, 92%);
  margin: 0 auto;
}

.site-header {
  background: #111827;
  color: white;
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav {
  min-height: 70px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  color: white;
  text-decoration: none;
  font-size: 1.45rem;
  font-weight: 800;
}

nav {
  display: flex;
  gap: 24px;
}

nav a {
  color: #d1d5db;
  text-decoration: none;
  font-weight: 600;
}

nav a:hover {
  color: white;
}

.hero {
  padding: 100px 0;
  background: linear-gradient(135deg, #111827, #374151);
  color: white;
}

.eyebrow {
  font-size: .8rem;
  font-weight: 800;
  letter-spacing: 2px;
  color: #a7f3d0;
  margin-bottom: 14px;
}

h1 {
  font-size: clamp(2.7rem, 7vw, 5.2rem);
  line-height: 1;
  max-width: 800px;
}

h1 span {
  color: #34d399;
}

.hero-text {
  max-width: 620px;
  margin: 24px 0 30px;
  color: #d1d5db;
  font-size: 1.1rem;
}

.button {
  display: inline-block;
  padding: 13px 22px;
  border-radius: 10px;
  background: #34d399;
  color: #064e3b;
  text-decoration: none;
  font-weight: 800;
}

.categories,
.picks {
  padding: 70px 0;
}

h2 {
  font-size: 2rem;
  margin-bottom: 24px;
}

.category-grid,
.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.category-grid {
  grid-template-columns: repeat(2, 1fr);
}

.category-card,
.product-card {
  background: white;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 8px 25px rgba(17, 24, 39, .08);
}

.category-card {
  text-decoration: none;
  color: #111827;
  font-size: 1.4rem;
}

.category-card strong,
.category-card span {
  display: block;
}

.category-card span {
  color: #6b7280;
  font-size: .95rem;
  margin-top: 5px;
}

.category-card:hover,
.product-card:hover {
  transform: translateY(-3px);
}

.product-image {
  height: 150px;
  display: grid;
  place-items: center;
  background: #eef2f7;
  border-radius: 12px;
  font-size: 4rem;
  margin-bottom: 18px;
}

.product-card h3 {
  margin-bottom: 8px;
}

.product-card p {
  color: #6b7280;
  margin-bottom: 18px;
}

.product-link {
  color: #059669;
  text-decoration: none;
  font-weight: 800;
}

.other-section {
  margin-top: 20px;
}

footer {
  background: #111827;
  color: #9ca3af;
  text-align: center;
  padding: 35px 0;
}

.disclosure {
  margin-top: 8px;
  font-size: .85rem;
}

@media (max-width: 750px) {
  .category-grid,
  .product-grid {
    grid-template-columns: 1fr;
  }

  .hero {
    padding: 75px 0;
  }

  nav {
    gap: 12px;
  }
}

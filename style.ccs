:root {
  --ink: #101B16;
  --ink-soft: #17241D;
  --ivory: #F1ECDD;
  --ivory-dim: #E4DCC7;
  --brass: #B08D3E;
  --brass-bright: #C9A227;
  --rust: #A8503A;
  --sage: #4E6358;
  --text-dark: #1B2117;
  --text-muted: #5C6A5F;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--ink);
  color: var(--ivory);
  font-family: 'Inter', sans-serif;
  line-height: 1.5;
}

h1, h2, h3, .wordmark {
  font-family: 'Fraunces', serif;
  font-weight: 500;
}

a {
  color: inherit;
}

:focus-visible {
  outline: 2px solid var(--brass-bright);
  outline-offset: 3px;
}

/* MASTHEAD */
.masthead {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px 48px;
  border-bottom: 1px solid rgba(177, 141, 62, 0.35);
}

.wordmark {
  font-size: 1.3rem;
  letter-spacing: 0.3px;
}

.masthead nav a {
  text-decoration: none;
  color: var(--ivory-dim);
  margin-left: 32px;
  font-size: 0.92rem;
  padding-bottom: 3px;
  border-bottom: 1px solid transparent;
  transition: border-color 0.2s, color 0.2s;
}

.masthead nav a:hover {
  color: var(--brass-bright);
  border-bottom-color: var(--brass-bright);
}

/* COVER / HERO */
.cover {
  padding: 120px 48px 100px;
  display: flex;
  justify-content: center;
  text-align: center;
  background:
    radial-gradient(ellipse at 50% -10%, rgba(177, 141, 62, 0.16), transparent 55%),
    var(--ink);
}

.cover-inner {
  max-width: 640px;
  animation: rise 0.9s ease-out both;
}

@keyframes rise {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: translateY(0); }
}

.cover-kicker {
  color: var(--brass-bright);
  font-size: 0.95rem;
  margin-bottom: 22px;
}

.cover h1 {
  font-size: 3rem;
  line-height: 1.15;
  font-weight: 500;
  color: var(--ivory);
}

.stamp-btn {
  display: inline-block;
  margin-top: 40px;
  padding: 14px 30px;
  background: var(--brass-bright);
  color: var(--ink);
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
  transform: rotate(-1deg);
  box-shadow: 3px 3px 0 rgba(177, 141, 62, 0.3);
  transition: transform 0.2s, box-shadow 0.2s;
}

.stamp-btn:hover {
  transform: rotate(-1deg) translateY(-2px);
  box-shadow: 5px 5px 0 rgba(177, 141, 62, 0.3);
}

/* SHELVES (SECTIONS) */
.shelf {
  padding: 80px 48px;
  max-width: 1180px;
  margin: 0 auto;
}

.shelf.alt {
  background: var(--ink-soft);
  max-width: 100%;
}

.shelf.alt > * {
  max-width: 1180px;
  margin-left: auto;
  margin-right: auto;
}

.shelf-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  border-bottom: 1px solid rgba(177, 141, 62, 0.3);
  padding-bottom: 18px;
  margin-bottom: 40px;
  flex-wrap: wrap;
  gap: 8px;
}

.shelf-head h2 {
  font-size: 1.6rem;
  color: var(--ivory);
}

.shelf-head p {
  color: var(--text-muted);
  color: #9AA79A;
  font-size: 0.95rem;
}

/* LOT CARDS */
.lots {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 28px;
}

.lot {
  position: relative;
  background: var(--ivory);
  border: 1px solid rgba(16, 27, 22, 0.12);
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.lot:hover {
  transform: translateY(-6px);
  border-color: var(--brass);
  box-shadow: 0 14px 28px rgba(0, 0, 0, 0.35);
}

.lot-tag {
  position: absolute;
  top: 14px;
  left: 14px;
  background: var(--ink);
  color: var(--brass-bright);
  font-family: 'Fraunces', serif;
  font-size: 0.8rem;
  padding: 4px 10px;
  z-index: 2;
}

.lot-image img {
  width: 100%;
  display: block;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}

.lot-body {
  padding: 20px 22px 22px;
}

.lot-body h3 {
  color: var(--text-dark);
  font-size: 1.15rem;
  margin-bottom: 8px;
}

.lot-body p {
  color: var(--text-muted);
  font-size: 0.92rem;
  margin-bottom: 20px;
}

.lot-foot {
  border-top: 1px dashed rgba(16, 27, 22, 0.25);
  padding-top: 16px;
}

.view-pick {
  display: inline-block;
  text-decoration: none;
  color: var(--rust);
  font-weight: 600;
  font-size: 0.92rem;
  text-underline-offset: 4px;
  border-bottom: 1px solid var(--rust);
  padding-bottom: 2px;
  transition: opacity 0.2s;
}

.view-pick:hover {
  opacity: 0.75;
}

/* FOOTER */
.ledger-footer {
  border-top: 1px solid rgba(177, 141, 62, 0.3);
  padding: 28px 48px;
  text-align: center;
}

.ledger-footer p {
  color: #7C8A7E;
  font-size: 0.82rem;
}

/* MOBILE */
@media (max-width: 640px) {
  .masthead {
    flex-direction: column;
    gap: 12px;
    padding: 20px 24px;
  }
  .masthead nav a {
    margin: 0 12px;
  }
  .cover {
    padding: 80px 24px 70px;
  }
  .cover h1 {
    font-size: 2.1rem;
  }
  .shelf {
    padding: 56px 24px;
  }
  .shelf-head {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cover-inner {
    animation: none;
  }
  .lot, .stamp-btn {
    transition: none;
  }
}
